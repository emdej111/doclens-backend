# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used for summaries and Q&A
CLAUDE_MODEL=claude-sonnet-4-6

# FastAPI backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Used by the Streamlit frontend to reach the backend
BACKEND_URL=http://localhost:8000

# RAG chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_CHUNKS=4

# Max characters of extracted text sent to Claude for the initial summary.
# Longer documents are summarized from a truncated prefix; the API tells the
# frontend when this happened so it isn't a silent truncation.
MAX_SUMMARY_CHARS=60000
